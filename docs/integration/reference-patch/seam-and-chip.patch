@@ -0,0 +1,50 @@
+import { personalizeMixedFeed } from 'farcaster-adapter';
+import type { ApiCastFeedItem } from 'farcaster-client-data';
+import type { DropReceipt, FeedSpec, MixSummary } from 'home-personalization';
+
+type HomePersonalizedPage = {
+  /** The render list. Same element type that came in, so nothing downstream changes. */
+  feedItems: ApiCastFeedItem[];
+  /** One per cast the reader's rules removed. Drives the hidden row and its ledger. */
+  homeReceipts: DropReceipt[];
+  homeMix: MixSummary | undefined;
+  homeHiddenCount: number;
+};
+
+/**
+ * Home's seam: filter and re-rank one page by the reader's own rules.
+ *
+ * Without a spec for this feed (no provider mounted, or a feed the reader has
+ * no rules for, such as a channel) the page comes back exactly as the server
+ * sent it. That is upstream behaviour, and it is what every feed other than
+ * the ones the reader has defined gets.
+ */
+function personalizeFeedItems(
+  items: ApiCastFeedItem[],
+  spec: FeedSpec | undefined,
+  now: number = Date.now(),
+): HomePersonalizedPage {
+  if (!spec) {
+    return {
+      feedItems: items,
+      homeReceipts: [],
+      homeMix: undefined,
+      homeHiddenCount: 0,
+    };
+  }
+  const result = personalizeMixedFeed(items, {
+    isCast: () => true,
+    getCast: (item) => item,
+    spec,
+    context: { now },
+  });
+  return {
+    feedItems: result.items,
+    homeReceipts: result.receipts,
+    homeMix: result.mix,
+    homeHiddenCount: result.hiddenCount,
+  };
+}
+
+export { personalizeFeedItems };
+export type { HomePersonalizedPage };
