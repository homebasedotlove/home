+                    onClick={() => choose('up')}
+                    className="rounded border border-default px-2 py-1 text-xs text-default"
+                  >
+                    More of this
+                  </button>
+                )}
+              </div>
+            )}
+          </div>
+        </AnchoredPopover>
+      </div>
+    );
+  },
+);
+
+HomeWhyChip.displayName = 'HomeWhyChip';
+
+export { HomeWhyChip };
