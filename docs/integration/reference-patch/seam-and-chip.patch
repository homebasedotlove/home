diff --git a/apps/farcaster-web/src/components/HomeMark.tsx b/apps/farcaster-web/src/components/HomeMark.tsx
new file mode 100644
index 0000000..97b938f
--- /dev/null
+++ b/apps/farcaster-web/src/components/HomeMark.tsx
@@ -0,0 +1,42 @@
+import React, { FC, memo } from 'react';
+
+/**
+ * Home's mark: a rounded square in the brand purple with an H drawn from three
+ * bars. The icon set in public/ is rendered from these same shapes, so the
+ * favicon, the app icon and the wordmark on screen are one drawing.
+ */
+const HomeMark: FC<{ size?: number; className?: string }> = memo(
+  ({ size = 24, className }) => (
+    <svg
+      width={size}
+      height={size}
+      viewBox="0 0 24 24"
+      aria-hidden="true"
+      className={className}
+    >
+      <rect width="24" height="24" rx="5.3" fill="#7959FF" />
+      <rect x="6" y="5" width="3.6" height="14" rx="1.3" fill="#fff" />
+      <rect x="14.4" y="5" width="3.6" height="14" rx="1.3" fill="#fff" />
+      <rect x="6" y="10.2" width="12" height="3.6" rx="1.3" fill="#fff" />
+    </svg>
+  ),
+);
+HomeMark.displayName = 'HomeMark';
+
+/** The mark and the name, in the display face. Inherits its text colour. */
+const HomeWordmark: FC<{ size?: number; className?: string }> = memo(
+  ({ size = 28, className = '' }) => (
+    <span className={`inline-flex items-center gap-2 ${className}`}>
+      <HomeMark size={size} />
+      <span
+        className="font-seasonMix font-semibold leading-none"
+        style={{ fontSize: Math.round(size * 0.9) }}
+      >
+        Home
+      </span>
+    </span>
+  ),
+);
+HomeWordmark.displayName = 'HomeWordmark';
+
+export { HomeMark, HomeWordmark };
