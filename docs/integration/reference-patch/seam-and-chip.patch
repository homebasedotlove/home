+import { homeFeedPage } from 'farcaster-adapter';
+import type { ApiCastFeedItem } from 'farcaster-client-data';
+import {
+  defaultPreferences,
+  getFeed,
+  muteReasonGroup,
+  nudgeReason,
+} from 'home-personalization';
+import { describe, expect, it } from 'vitest';
+
+import { personalizeFeedItems } from '../homePersonalize';
+
+const page = () => homeFeedPage() as unknown as ApiCastFeedItem[];
+
+describe('personalizeFeedItems', () => {
+  it('leaves a page untouched when the reader has no spec for that feed', () => {
+    const items = page();
+    const out = personalizeFeedItems(items, undefined);
+    expect(out.feedItems).toBe(items);
+    expect(out.homeReceipts).toEqual([]);
+    expect(out.homeHiddenCount).toBe(0);
+    expect(out.homeMix).toBeUndefined();
+  });
+
+  it('applies the reader\'s spec and accounts for every removal', () => {
+    const prefs = muteReasonGroup(defaultPreferences(), 'home', 'promoted');
+    const items = page();
+    const out = personalizeFeedItems(items, getFeed(prefs, 'home'), 1_764_600_000_000);
+    expect(out.feedItems.length + out.homeHiddenCount).toBe(items.length);
+    expect(out.homeReceipts.map((r) => r.cause)).toEqual(['muted-group']);
+    expect(out.homeReceipts[0]?.rule).toBe('promoted');
+    expect(out.feedItems.some((i) => i.meta?.includeReason?.type === 'snap-promoted')).toBe(false);
+    expect(out.homeMix?.byGroup.promoted).toBeUndefined();
+  });
+
+  it('re-ranks when a reason is nudged, and keeps the original objects', () => {
+    const items = page();
+    const server = personalizeFeedItems(items, getFeed(defaultPreferences(), 'home'), 1_764_600_000_000);
+    expect(server.feedItems.map((i) => i.id)).toEqual(items.map((i) => i.id));
+
+    const prefs = nudgeReason(nudgeReason(defaultPreferences(), 'home', 'discovery', 'down'), 'home', 'direct', 'up');
+    const nudged = personalizeFeedItems(items, getFeed(prefs, 'home'), 1_764_600_000_000);
+    expect(nudged.feedItems.map((i) => i.id)).not.toEqual(items.map((i) => i.id));
+    expect(nudged.feedItems.length).toBe(items.length);
+    for (const item of nudged.feedItems) expect(items).toContain(item);
+  });
+});
