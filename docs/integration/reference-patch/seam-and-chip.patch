diff --git a/apps/farcaster-web/src/components/casts/HomeWhyChip.tsx b/apps/farcaster-web/src/components/casts/HomeWhyChip.tsx
new file mode 100644
index 0000000..12148c8
--- /dev/null
+++ b/apps/farcaster-web/src/components/casts/HomeWhyChip.tsx
@@ -0,0 +1,134 @@
+import { ApiCastFeedIncludeReason } from 'farcaster-client-data';
+import type { HomeAdjust } from 'farcaster-client-hooks';
+import { useHomeAdjust } from 'farcaster-client-hooks';
+import { describeReason, explainReason, reasonGroup } from 'home-personalization';
+import React, { FC, memo, useCallback, useState } from 'react';
+
+import { AnchoredPopover } from '~/components/popovers/AnchoredPopover';
+
+/**
+ * Home's why-chip.
+ *
+ * The reference client already surfaces ranking reasons, in two places: an
+ * `IncludeReasonTopHat` on the feed row for two of the ten reasons, and a
+ * `SourceLabel` inside the kebab menu for eight of them. Neither has a press
+ * handler. So a reader can sometimes learn why a cast is there, and can never
+ * do anything about it.
+ *
+ * This renders in the same slot as the top hat, for every reason, and is a
+ * button. Tapping it is the whole product: the explanation and the control are
+ * the same object. Inside a feed, the controls write to the reader's
+ * preferences through the feed scope; anywhere else the sheet explains and
+ * offers none, rather than offering buttons that would do nothing.
+ *
+ * The sheet is the client's own anchored popover, so it flips to stay on
+ * screen and closes on Escape or a tap outside, like every other menu here.
+ */
+
+// Each group uses the client's own light and dark tokens. The semantic
+// `text-success` resolves to a variable scoped to `.snap-theme-scope`, which a
+// feed row is not inside, and `text-action-blue` is not a utility the config
+// generates at all; both rendered as plain text colour.
+const GROUP_CLASS: Record<string, string> = {
+  direct: 'text-action-green-light dark:text-action-green-dark',
+  network: 'text-action-blue-light dark:text-action-blue-dark',
+  discovery: 'text-action-purple-light dark:text-action-purple-dark',
+  promoted: 'text-faint',
+};
+
+type HomeWhyChipProps = {
+  includeReason: ApiCastFeedIncludeReason;
+  score?: number;
+  /** Overrides the feed scope. Tests and previews pass one; the feed does not. */
+  onAdjust?: HomeAdjust;
+};
+
+const HomeWhyChip: FC<HomeWhyChipProps> = memo(
+  ({ includeReason, score, onAdjust }) => {
+    const [open, setOpen] = useState(false);
+    const descriptor = describeReason(includeReason.type);
+    const group = reasonGroup(includeReason.type);
+    const scopedAdjust = useHomeAdjust();
+    const adjust = onAdjust ?? scopedAdjust;
+
+    const choose = useCallback(
+      (direction: 'up' | 'down' | 'off') => {
+        if (group && adjust) adjust(group, direction);
+        setOpen(false);
+      },
+      [group, adjust],
+    );
+
+    // An unknown reason still gets a chip rather than silence: upstream can add
+    // one at any time, and an unlabelled cast is the bug this exists to fix.
+    const label = descriptor?.chip ?? includeReason.type;
+    const canAdjust = Boolean(group && adjust);
+
+    return (
+      <div data-testid="home-why-chip">
+        <AnchoredPopover
+          open={open}
+          onOpenChange={setOpen}
+          sideOffset={6}
+          contentClassName="z-50 w-72 rounded-lg border border-default bg-app p-3 shadow-lg"
+          trigger={
+            <button
+              type="button"
+              className={`mb-1 inline-flex items-center gap-1.5 rounded border border-current px-1.5 py-0.5 text-[10px] uppercase tracking-wide ${
+                GROUP_CLASS[group ?? ''] ?? 'text-faint'
+              }`}
+              aria-expanded={open}
+              aria-label={`Why am I seeing this: ${label}`}
+            >
+              <span className="size-1.5 rounded-full bg-current" />
+              {label}
+            </button>
+          }
+        >
+          <div role="dialog" data-testid="home-why-sheet">
+            <p className="mb-1 text-sm text-default">
+              {explainReason(includeReason.type)}
+            </p>
+            {score !== undefined && (
+              <p className="mb-2 font-mono text-xs text-faint">
+                meta.score {score.toFixed(2)}
+              </p>
+            )}
+            {canAdjust && (
+              <div className="flex flex-wrap gap-2">
+                <button
+                  type="button"
+                  onClick={() => choose('down')}
+                  className="rounded border border-default px-2 py-1 text-xs text-default"
+                >
+                  Less of this
+                </button>
+                <button
+                  type="button"
+                  onClick={() => choose('off')}
+                  className="rounded border border-default px-2 py-1 text-xs text-default"
+                >
+                  None of this
+                </button>
+                {/* Promoted can be reduced or removed, never amplified. */}
+                {descriptor?.boostable !== false && (
