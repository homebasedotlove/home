diff --git a/packages/farcaster-client-hooks/src/providers/HomePreferencesProvider.tsx b/packages/farcaster-client-hooks/src/providers/HomePreferencesProvider.tsx
new file mode 100644
index 0000000..49119ae
--- /dev/null
+++ b/packages/farcaster-client-hooks/src/providers/HomePreferencesProvider.tsx
@@ -0,0 +1,149 @@
+import type {
+  FeedSpec,
+  KVStore,
+  Preferences,
+  ReasonGroup,
+} from 'home-personalization';
+import {
+  getFeed,
+  loadPreferences,
+  muteReasonGroup,
+  nudgeReason,
+  savePreferences,
+} from 'home-personalization';
+import React, {
+  createContext,
+  FC,
+  memo,
+  ReactNode,
+  useCallback,
+  useContext,
+  useMemo,
+  useRef,
+  useState,
+} from 'react';
+
+/**
+ * Home's preferences, for the whole app.
+ *
+ * One document, loaded once from the platform's key-value store and written
+ * back on every change. Every mutation is one of the kernel's pure actions, so
+ * this is a thin write-through cache and nothing more: no business logic
+ * accumulates here, and the same actions run identically in tests and in the
+ * demo CLI.
+ *
+ * Mounting it is optional. A feed hook that finds no provider leaves the page
+ * exactly as the server sent it, which is upstream behaviour, so the mobile
+ * app keeps building and running unchanged until it mounts one over MMKV.
+ */
+type HomePreferencesContextValue = {
+  preferences: Preferences;
+  /** Apply one of the kernel's pure actions and persist the result. */
+  update: (fn: (prefs: Preferences) => Preferences) => void;
+  /**
+   * The reader's spec for one of the client's feed keys ('home', 'following',
+   * a channel key). Undefined means "leave that feed as the server sent it".
+   */
+  specFor: (feedKey: string) => FeedSpec | undefined;
+};
+
+const HomePreferencesContext =
+  createContext<HomePreferencesContextValue | null>(null);
+
+type HomePreferencesProviderProps = {
+  store: KVStore;
+  children: ReactNode;
+};
+
+const HomePreferencesProvider: FC<HomePreferencesProviderProps> = memo(
+  ({ store, children }) => {
+    // Read synchronously, once. Preferences are needed during the first render
+    // of the feed, and an async read there is a frame of the wrong feed on
+    // every cold start.
+    const [preferences, setPreferences] = useState(
+      () => loadPreferences(store).preferences,
+    );
+    const latest = useRef(preferences);
+
+    const update = useCallback(
+      (fn: (prefs: Preferences) => Preferences) => {
+        const next = fn(latest.current);
+        if (next === latest.current) return;
+        latest.current = next;
+        savePreferences(store, next);
+        setPreferences(next);
+      },
+      [store],
+    );
+
+    const specFor = useCallback(
+      (feedKey: string) => getFeed(preferences, feedKey),
+      [preferences],
+    );
+
+    const value = useMemo(
+      () => ({ preferences, update, specFor }),
+      [preferences, update, specFor],
+    );
+
+    return (
+      <HomePreferencesContext.Provider value={value}>
+        {children}
+      </HomePreferencesContext.Provider>
+    );
+  },
+);
+HomePreferencesProvider.displayName = 'HomePreferencesProvider';
+
+/** Null when no provider is mounted. Callers treat that as "no personalization". */
+const useHomePreferences = () => useContext(HomePreferencesContext);
+
+/**
+ * Which feed the casts on screen belong to, so a why-chip inside one knows
+ * which spec its Less / None / More should change. Provided by the page that
+ * renders a feed and absent everywhere else (a conversation, notifications),
+ * where the chip explains and offers no controls.
+ */
+const HomeFeedScopeContext = createContext<string | null>(null);
+
+type HomeFeedScopeProviderProps = { feedId: string; children: ReactNode };
+
+const HomeFeedScopeProvider: FC<HomeFeedScopeProviderProps> = memo(
+  ({ feedId, children }) => (
+    <HomeFeedScopeContext.Provider value={feedId}>
+      {children}
+    </HomeFeedScopeContext.Provider>
+  ),
+);
+HomeFeedScopeProvider.displayName = 'HomeFeedScopeProvider';
+
+const useHomeFeedScope = () => useContext(HomeFeedScopeContext);
+
+type HomeAdjust = (
+  group: ReasonGroup,
+  direction: 'up' | 'down' | 'off',
+) => void;
+
+/** What a why-chip's buttons call. Undefined outside a feed or without a provider. */
+const useHomeAdjust = (): HomeAdjust | undefined => {
+  const update = useHomePreferences()?.update;
+  const feedId = useHomeFeedScope();
+  return useMemo(() => {
+    if (!update || !feedId) return undefined;
+    return (group: ReasonGroup, direction: 'up' | 'down' | 'off') =>
+      update((prefs) =>
+        direction === 'off'
+          ? muteReasonGroup(prefs, feedId, group)
+          : nudgeReason(prefs, feedId, group, direction),
+      );
+  }, [update, feedId]);
+};
+
+export {
+  HomeFeedScopeProvider,
+  HomePreferencesProvider,
+  useHomeAdjust,
+  useHomeFeedScope,
+  useHomePreferences,
+};
+export type { HomeAdjust, HomePreferencesContextValue };
