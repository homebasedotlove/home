diff --git a/apps/farcaster-web/src/utils/homePreferencesStore.ts b/apps/farcaster-web/src/utils/homePreferencesStore.ts
new file mode 100644
index 0000000..baca01b
--- /dev/null
+++ b/apps/farcaster-web/src/utils/homePreferencesStore.ts
@@ -0,0 +1,34 @@
+import type { KVStore } from 'home-personalization';
+
+/**
+ * The kernel's storage interface over localStorage.
+ *
+ * Every call is guarded. A private window, a full quota, or a storage-blocking
+ * policy must degrade to defaults for this session and never throw during the
+ * first render of the feed.
+ */
+const homePreferencesStore: KVStore = {
+  getString: (key) => {
+    try {
+      return window.localStorage.getItem(key) ?? undefined;
+    } catch {
+      return undefined;
+    }
+  },
+  setString: (key, value) => {
+    try {
+      window.localStorage.setItem(key, value);
+    } catch {
+      // Quota or private mode: the in-memory copy still applies this session.
+    }
+  },
+  remove: (key) => {
+    try {
+      window.localStorage.removeItem(key);
+    } catch {
+      // Same.
+    }
+  },
+};
+
+export { homePreferencesStore };
