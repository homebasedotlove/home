diff --git a/apps/farcaster-web/src/components/casts/__tests__/HomeWhyChip.test.tsx b/apps/farcaster-web/src/components/casts/__tests__/HomeWhyChip.test.tsx
new file mode 100644
index 0000000..ab7ae0e
--- /dev/null
+++ b/apps/farcaster-web/src/components/casts/__tests__/HomeWhyChip.test.tsx
@@ -0,0 +1,157 @@
+// @vitest-environment jsdom
+
+import { render, screen } from '@testing-library/react';
+import React from 'react';
+import userEvent from '@testing-library/user-event';
+import {
+  HomeFeedScopeProvider,
+  HomePreferencesProvider,
+} from 'farcaster-client-hooks';
+import {
+  getFeed,
+  loadPreferences,
+  memoryStore,
+  PREFERENCES_KEY,
+} from 'home-personalization';
+import { beforeAll, describe, expect, it, vi } from 'vitest';
+
+import { HomeWhyChip } from '~/components/casts/HomeWhyChip';
+
+// The sheet is the client's anchored popover, which portals into this node.
+beforeAll(() => {
+  const root = document.createElement('div');
+  root.id = 'popover-root';
+  document.body.appendChild(root);
+});
+
+/**
+ * Runs in the client's own vitest harness, against the client's own React and
+ * Testing Library. What it proves is narrow and specific: Home's kernel is
+ * importable from inside the app, the chip renders for every reason the API can
+ * send, and tapping it inside a feed changes the reader's preferences, which
+ * is the thing the upstream SourceLabel and IncludeReasonTopHat do not do.
+ */
+describe('HomeWhyChip', () => {
+  it('renders a chip for every reason the API can send', () => {
+    const reasons = [
+      'following-author', 'evergreen-following-author', 'follow-of-follow',
+      'recasted-by-following', 'has-reply-by-followed', 'pinned-in-channel',
+      'popular-in-channel', 'popular', 'high-quality-unfollowed', 'snap-promoted',
+    ] as const;
+
+    for (const type of reasons) {
+      const { unmount } = render(
+        <HomeWhyChip includeReason={{ type } as never} />,
+      );
+      const chip = screen.getByTestId('home-why-chip');
+      // Upstream renders nothing at all for the two following-author reasons.
+      expect(chip.textContent?.trim().length ?? 0).toBeGreaterThan(0);
+      unmount();
+    }
+  });
+
+  it('explains the reason and shows the score when tapped', async () => {
+    render(
+      <HomeWhyChip
+        includeReason={{ type: 'popular' } as never}
+        score={0.71}
+        onAdjust={() => {}}
+      />,
+    );
+    expect(screen.queryByTestId('home-why-sheet')).toBeNull();
+
+    await userEvent.click(screen.getByRole('button'));
+
+    const sheet = screen.getByTestId('home-why-sheet');
+    expect(sheet.textContent).toContain('popular right now');
+    expect(sheet.textContent).toContain('0.71');
+    expect(screen.getByText('Less of this')).toBeTruthy();
+    expect(screen.getByText('None of this')).toBeTruthy();
+    expect(screen.getByText('More of this')).toBeTruthy();
+  });
+
+  it('explains without offering controls outside a feed', async () => {
+    render(<HomeWhyChip includeReason={{ type: 'popular' } as never} />);
+    await userEvent.click(screen.getByRole('button'));
+    expect(screen.getByTestId('home-why-sheet').textContent).toContain(
+      'popular right now',
+    );
+    // No feed scope and no handler: buttons that would do nothing are not shown.
+    expect(screen.queryByText('Less of this')).toBeNull();
+    expect(screen.queryByText('None of this')).toBeNull();
+  });
+
+  it('closes on Escape and on a tap outside, like every other menu', async () => {
+    render(
+      <div>
+        <p>elsewhere</p>
+        <HomeWhyChip includeReason={{ type: 'popular' } as never} />
+      </div>,
+    );
+    await userEvent.click(screen.getByRole('button'));
+    expect(screen.getByTestId('home-why-sheet')).toBeTruthy();
+    await userEvent.keyboard('{Escape}');
+    expect(screen.queryByTestId('home-why-sheet')).toBeNull();
+
+    await userEvent.click(screen.getByRole('button'));
+    expect(screen.getByTestId('home-why-sheet')).toBeTruthy();
+    await userEvent.click(screen.getByText('elsewhere'));
+    expect(screen.queryByTestId('home-why-sheet')).toBeNull();
+  });
+
+  it('reports the group and direction the reader chose', async () => {
+    const onAdjust = vi.fn();
+    render(
+      <HomeWhyChip
+        includeReason={{ type: 'high-quality-unfollowed' } as never}
+        onAdjust={onAdjust}
+      />,
+    );
+    await userEvent.click(screen.getByRole('button'));
+    await userEvent.click(screen.getByText('Less of this'));
+    expect(onAdjust).toHaveBeenCalledWith('discovery', 'down');
+  });
+
+  it('writes the choice to the reader\'s preferences inside a feed', async () => {
+    const store = memoryStore();
+    render(
+      <HomePreferencesProvider store={store}>
+        <HomeFeedScopeProvider feedId="home">
+          <HomeWhyChip includeReason={{ type: 'popular' } as never} />
+        </HomeFeedScopeProvider>
+      </HomePreferencesProvider>,
+    );
+    const home = () => getFeed(loadPreferences(store).preferences, 'home')!;
+    expect(store.getString(PREFERENCES_KEY)).toBeUndefined();
+
+    await userEvent.click(screen.getByRole('button'));
+    await userEvent.click(screen.getByText('Less of this'));
+    expect(home().sort.mode).toBe('weighted');
+    expect(home().sort.weights.discovery).toBe(0.6);
+    expect(screen.queryByTestId('home-why-sheet')).toBeNull();
+
+    await userEvent.click(screen.getByRole('button'));
+    await userEvent.click(screen.getByText('None of this'));
+    expect(home().sift.mutedGroups).toEqual(['discovery']);
+  });
+
+  it('never offers to boost promoted content', async () => {
+    render(
+      <HomeWhyChip
+        includeReason={{ type: 'snap-promoted' } as never}
+        onAdjust={() => {}}
+      />,
+    );
+    await userEvent.click(screen.getByRole('button'));
+    expect(screen.getByText('Less of this')).toBeTruthy();
+    expect(screen.getByText('None of this')).toBeTruthy();
+    expect(screen.queryByText('More of this')).toBeNull();
+  });
+
+  it('labels an unknown future reason rather than rendering nothing', () => {
+    render(<HomeWhyChip includeReason={{ type: 'brand-new-reason' } as never} />);
+    expect(screen.getByTestId('home-why-chip').textContent).toContain(
+      'brand-new-reason',
+    );
+  });
+});
diff --git a/apps/farcaster-web/src/components/feeds/HomeHiddenRow.tsx b/apps/farcaster-web/src/components/feeds/HomeHiddenRow.tsx
new file mode 100644
index 0000000..45cbd75
--- /dev/null
+++ b/apps/farcaster-web/src/components/feeds/HomeHiddenRow.tsx
@@ -0,0 +1,86 @@
+import { useHomePreferences } from 'farcaster-client-hooks';
+import type { DropReceipt, ReceiptGroup } from 'home-personalization';
+import {
+  groupReceipts,
+  summarizeReceipts,
+  undoDrop,
+  UNDO_LABEL,
+} from 'home-personalization';
+import React, { FC, memo, useCallback, useMemo, useState } from 'react';
+
+/**
+ * "N casts hidden on this page." and the ledger behind it.
+ *
+ * An unauditable filter is indistinguishable from a bug, so every cast the
+ * reader's rules remove is accounted for here, one row per rule, with the
+ * button that reverses that rule. The kernel names each row and its button;
+ * this only lays them out. Filtering ships with this row or not at all.
+ */
+
+type HomeHiddenRowProps = {
+  feedId: string;
+  receipts: DropReceipt[];
+};
+
+const HomeHiddenRow: FC<HomeHiddenRowProps> = memo(({ feedId, receipts }) => {
+  const update = useHomePreferences()?.update;
+  const [open, setOpen] = useState(false);
+  const rows = useMemo(() => groupReceipts(receipts), [receipts]);
+  const summary = summarizeReceipts(receipts);
+
+  const undo = useCallback(
+    (row: ReceiptGroup) =>
+      update?.((prefs) => undoDrop(prefs, feedId, row.cause, row.rule)),
+    [update, feedId],
+  );
+
+  if (!summary || !update) return null;
+
+  return (
+    <div
+      className="border-b border-default px-4 py-2 text-sm"
+      data-testid="home-hidden-row"
+    >
+      <button
+        type="button"
+        className="flex w-full items-center justify-between gap-2 text-faint"
+        aria-expanded={open}
+        onClick={() => setOpen((v) => !v)}
+      >
+        <span>{summary}</span>
+        <span aria-hidden="true">{open ? '▴' : '▾'}</span>
+      </button>
+      {open && (
+        <ul className="mt-2 flex flex-col gap-2" data-testid="home-receipts">
+          {rows.map((row) => (
+            <li
+              key={row.key}
+              className="flex items-center justify-between gap-3"
+            >
+              <div className="min-w-0">
+                <div className="font-semibold text-default">
+                  {row.label}{' '}
+                  <span className="font-normal text-faint">
+                    · {row.count} hidden
+                  </span>
+                </div>
+                <div className="text-xs text-faint">{row.detail}</div>
+              </div>
+              <button
+                type="button"
+                className="shrink-0 rounded border border-default px-2 py-1 text-xs text-default"
+                onClick={() => undo(row)}
+              >
+                {UNDO_LABEL[row.cause]}
+              </button>
+            </li>
+          ))}
+        </ul>
+      )}
+    </div>
+  );
+});
+
+HomeHiddenRow.displayName = 'HomeHiddenRow';
+
+export { HomeHiddenRow };
diff --git a/apps/farcaster-web/src/components/feeds/__tests__/HomeHiddenRow.test.tsx b/apps/farcaster-web/src/components/feeds/__tests__/HomeHiddenRow.test.tsx
new file mode 100644
index 0000000..259bf5b
--- /dev/null
+++ b/apps/farcaster-web/src/components/feeds/__tests__/HomeHiddenRow.test.tsx
@@ -0,0 +1,92 @@
+// @vitest-environment jsdom
+
+import { render, screen } from '@testing-library/react';
+import React from 'react';
+import userEvent from '@testing-library/user-event';
+import { homeFeedPage, personalizeMixedFeed } from 'farcaster-adapter';
+import { HomePreferencesProvider } from 'farcaster-client-hooks';
+import {
+  defaultPreferences,
+  exportPreferences,
+  getFeed,
+  loadPreferences,
+  memoryStore,
+  muteKeyword,
+  muteReasonGroup,
+  PREFERENCES_KEY,
+} from 'home-personalization';
+import type { KVStore, Preferences } from 'home-personalization';
+import { describe, expect, it } from 'vitest';
+
+import { HomeHiddenRow } from '~/components/feeds/HomeHiddenRow';
+
+/** The receipts a real page produces under the reader's rules. */
+const receiptsFor = (prefs: Preferences) =>
+  personalizeMixedFeed(homeFeedPage(), {
+    isCast: () => true,
+    getCast: (item) => item,
+    spec: getFeed(prefs, 'home')!,
+    context: { now: 1_764_600_000_000 },
+  }).receipts;
+
+const seeded = (prefs: Preferences): KVStore =>
+  memoryStore({ [PREFERENCES_KEY]: exportPreferences(prefs) });
+
+describe('HomeHiddenRow', () => {
+  it('renders nothing when nothing was hidden', () => {
+    const { container } = render(
+      <HomePreferencesProvider store={memoryStore()}>
+        <HomeHiddenRow feedId="home" receipts={[]} />
+      </HomePreferencesProvider>,
+    );
+    expect(container.innerHTML).toBe('');
+  });
+
+  it('accounts for every removal, one row per rule, with its undo', async () => {
+    const prefs = muteKeyword(
+      muteReasonGroup(defaultPreferences(), 'home', 'promoted'),
+      'home',
+      'brooklyn',
+    );
+    const receipts = receiptsFor(prefs);
+    expect(receipts.length).toBe(2);
+
+    render(
+      <HomePreferencesProvider store={seeded(prefs)}>
+        <HomeHiddenRow feedId="home" receipts={receipts} />
+      </HomePreferencesProvider>,
+    );
+    expect(screen.getByText('2 casts hidden on this page.')).toBeTruthy();
+    expect(screen.queryByTestId('home-receipts')).toBeNull();
+
+    await userEvent.click(screen.getByText('2 casts hidden on this page.'));
+    const ledger = screen.getByTestId('home-receipts');
+    expect(ledger.textContent).toContain('Promoted');
+    expect(ledger.textContent).toContain('“brooklyn”');
+    expect(ledger.textContent).toContain('1 hidden');
+    expect(screen.getByText('Turn back on')).toBeTruthy();
+    expect(screen.getByText('Unmute')).toBeTruthy();
+  });
+
+  it('undo reverses exactly the rule on that row', async () => {
+    const prefs = muteKeyword(
+      muteReasonGroup(defaultPreferences(), 'home', 'promoted'),
+      'home',
+      'brooklyn',
+    );
+    const store = seeded(prefs);
+    render(
+      <HomePreferencesProvider store={store}>
+        <HomeHiddenRow feedId="home" receipts={receiptsFor(prefs)} />
+      </HomePreferencesProvider>,
+    );
+    await userEvent.click(screen.getByText('2 casts hidden on this page.'));
+    await userEvent.click(screen.getByText('Turn back on'));
+
+    const home = getFeed(loadPreferences(store).preferences, 'home')!;
+    expect(home.sift.mutedGroups).toEqual([]);
+    expect(home.sift.keywords.map((k) => k.pattern)).toEqual(['brooklyn']);
+    // And the page re-filtered under the new rules hides one cast, not two.
+    expect(receiptsFor(loadPreferences(store).preferences).length).toBe(1);
+  });
+});
